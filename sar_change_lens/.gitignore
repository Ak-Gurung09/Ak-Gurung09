# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Raw satellite data is large and is re-downloadable from NASA archives:
# never commit it. Record granule IDs/URLs in config/cases/*.yaml instead.
data/raw/*
!data/raw/.gitkeep

# Pipeline outputs are regenerated by `python -m changelens.pipeline`.
# For the final demo, commit the small web assets of validated cases
# (summary.json, detections.geojson, report.md, provenance.json, previews/*.png),
# e.g. with `git add -f outputs/<case_id>/...`.
outputs/*
!outputs/.gitkeep
*.tif
*.h5
